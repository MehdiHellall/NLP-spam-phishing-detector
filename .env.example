# Backend model artifact options.
# Use either a local path mounted into the backend container:
EMAIL_THREAT_MODEL_PATH=artifacts/tfidf_logreg.joblib

# Or a remote artifact URL with a required SHA-256 checksum.
# Non-loopback remote URLs must use https because joblib artifacts are trusted code.
# EMAIL_THREAT_MODEL_URL=https://example.com/models/tfidf_logreg.joblib
# EMAIL_THREAT_MODEL_SHA256=
# EMAIL_THREAT_MODEL_CACHE_PATH=/tmp/threatlens/model.joblib

# Hosted/container runtimes can warm the large artifact in the background.
EMAIL_THREAT_BACKGROUND_WARMUP=true

# Basic abuse controls for unauthenticated prediction requests.
EMAIL_THREAT_RATE_LIMIT_PER_MINUTE=60
EMAIL_THREAT_MAX_BODY_BYTES=16384

# Comma-separated browser origins allowed to call the API.
EMAIL_THREAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Frontend build/runtime configuration.
VITE_API_BASE_URL=http://localhost:8000
